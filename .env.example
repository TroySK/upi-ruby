# UPI gem — copy to .env and fill from your PSP dashboard.
UPI_PROVIDER=phonepe
UPI_ENV=sandbox
UPI_MERCHANT_ID=MERCHANTUAT
UPI_SALT_KEY=your-phonepe-salt-key
UPI_SALT_INDEX=1
# Paytm (when UPI_PROVIDER=paytm):
# UPI_MERCHANT_KEY=your-paytm-merchant-key
# UPI_WEBSITE=WEBSTAGING
UPI_TIMEOUT=30000
# UPI_DEBUG=false
# UPI_CALLBACK_URL=https://yoursite.com/upi/webhooks/phonepe
# UPI_REDIRECT_URL=https://yoursite.com/payment-complete
# UPI_MAX_RETRIES=3
# UPI_RETRY_DELAY_MS=1000
